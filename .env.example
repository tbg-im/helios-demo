# OAuth2 credentials from the app's registration in Teambridge. Demo sign-ups become users in
# the account these credentials belong to.
TB_CLIENT_ID=your-client-id
TB_CLIENT_SECRET=your-client-secret

# Local development only.
TB_DEV_MODE=true

# This is a public page opened directly, not embedded in Teambridge, so leave APP_SLUG unset:
# setting it would serve the app under /apps/<slug>.

# API configuration (optional - defaults shown)
# TB_OPEN_API_BASE_URL=https://open-api.teambridge.com
# TB_AUTH_URL=https://teambridge.us.auth0.com/oauth/token
# TB_AUDIENCE=https://api.teambridge.com/openapi/
